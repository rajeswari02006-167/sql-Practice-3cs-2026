SELECT COUNT(*) AS total_records FROM irrigation_data;

SELECT field_id, sensor_id, reading_time, soil_moisture,
       temperature, irrigation_status
FROM   irrigation_data
ORDER  BY record_id;

SELECT field_id, sensor_id, reading_time, soil_moisture
FROM   irrigation_data
WHERE  soil_moisture < 30
ORDER  BY field_id, reading_time;

SELECT field_id, ROUND(AVG(soil_moisture), 2) AS avg_soil_moisture
FROM   irrigation_data
GROUP  BY field_id
ORDER  BY field_id;

SELECT field_id, ROUND(SUM(water_usage_mm), 2) AS total_water_usage
FROM   irrigation_data
GROUP  BY field_id
ORDER  BY field_id;

SELECT irrigation_status, COUNT(*) AS total_records
FROM   irrigation_data
GROUP  BY irrigation_status
ORDER  BY irrigation_status;

