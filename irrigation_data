
CREATE TABLE irrigation_data (
    record_id          INTEGER       PRIMARY KEY,
    field_id           TEXT          NOT NULL,
    sensor_id          TEXT          NOT NULL,
    reading_time       TEXT          NOT NULL,
    soil_moisture      REAL          NOT NULL,
    temperature        REAL          NOT NULL,
    water_usage_mm     REAL          NOT NULL,
    irrigation_status  TEXT          NOT NULL,
    CONSTRAINT chk_moist   CHECK (soil_moisture BETWEEN 0 AND 100),
    CONSTRAINT chk_water   CHECK (water_usage_mm >= 0),
    CONSTRAINT chk_status  CHECK (irrigation_status IN ('ON','OFF','SCHEDULED'))
);

