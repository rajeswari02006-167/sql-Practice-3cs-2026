-- PL/SQL Function 1: Recommend irrigation status from soil moisture
--   below 30  -> ON,   30 to 49.99 -> SCHEDULED,   50 or above -> OFF
CREATE OR REPLACE FUNCTION fn_recommend_status (p_moisture IN NUMBER)
RETURN VARCHAR2
IS
BEGIN
    IF p_moisture IS NULL THEN
        RAISE_APPLICATION_ERROR(-20001, 'Soil moisture cannot be NULL.');
    END IF;

    IF p_moisture < 0 OR p_moisture > 100 THEN
        RAISE_APPLICATION_ERROR(-20002, 'Soil moisture must be between 0 and 100.');
    END IF;

    IF p_moisture < 30 THEN
        RETURN 'ON';
    ELSIF p_moisture < 50 THEN
        RETURN 'SCHEDULED';
    ELSE
        RETURN 'OFF';
    END IF;
END fn_recommend_status;
/

-- PL/SQL Procedure 2: Update irrigation status for a selected field
CREATE OR REPLACE PROCEDURE sp_update_status (
    p_field_id IN VARCHAR2,
    p_status   IN VARCHAR2
)
IS
    v_rows NUMBER;
BEGIN
    IF p_field_id IS NULL OR p_status IS NULL THEN
        RAISE_APPLICATION_ERROR(-20003, 'Field ID and status are required.');
    END IF;

    IF p_status NOT IN ('ON', 'OFF', 'SCHEDULED') THEN
        RAISE_APPLICATION_ERROR(-20004, 'Invalid status. Use ON, OFF or SCHEDULED.');
    END IF;

    UPDATE irrigation_data
    SET    irrigation_status = p_status
    WHERE  field_id = p_field_id;

    v_rows := SQL%ROWCOUNT;

    IF v_rows = 0 THEN
        RAISE_APPLICATION_ERROR(-20005, 'No records found for field ' || p_field_id);
    END IF;

    COMMIT;
    DBMS_OUTPUT.PUT_LINE('Field ' || p_field_id || ': status updated to ' || p_status ||
                         ' (' || v_rows || ' records).');
END sp_update_status;
/

-- PL/SQL Procedure 3: Field-wise soil moisture and water consumption report
--   (pass a field ID, or leave empty to report on all fields)
CREATE OR REPLACE PROCEDURE sp_field_report (
    p_field_id IN VARCHAR2 DEFAULT NULL
)
IS
    v_count NUMBER := 0;
BEGIN
    DBMS_OUTPUT.PUT_LINE('FIELD-WISE SOIL MOISTURE AND WATER REPORT');
    DBMS_OUTPUT.PUT_LINE(RPAD('FIELD', 8) || RPAD('READINGS', 10) || RPAD('AVG MOISTURE', 15) ||
                         RPAD('AVG TEMP', 11) || 'TOTAL WATER (mm)');

    FOR r IN (SELECT field_id,
                     COUNT(*)                       AS readings,
                     ROUND(AVG(soil_moisture), 2)   AS avg_moist,
                     ROUND(AVG(temperature), 2)     AS avg_temp,
                     ROUND(SUM(water_usage_mm), 2)  AS total_water
              FROM   irrigation_data
              WHERE  p_field_id IS NULL
                 OR  UPPER(field_id) = UPPER(TRIM(p_field_id))
              GROUP  BY field_id
              ORDER  BY field_id)
    LOOP
        v_count := v_count + 1;
        DBMS_OUTPUT.PUT_LINE(RPAD(r.field_id, 8) || RPAD(r.readings, 10) ||
                             RPAD(r.avg_moist, 15) || RPAD(r.avg_temp, 11) ||
                             r.total_water);
    END LOOP;

    IF v_count = 0 THEN
        RAISE_APPLICATION_ERROR(-20006, 'No records found for field: ' || p_field_id);
    END IF;
END sp_field_report;
/

